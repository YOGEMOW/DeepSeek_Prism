+// @vitest-environment jsdom
+// VEP/1 evidence disclosure in user bubbles: the DeepSeek Prism image
+// fallback wrapper folds into a link until expanded; ordinary text and
+// multi-block ordering stay intact, and the joined copy text still carries
+// the full evidence.
+
+import { afterEach, describe, expect, it, vi } from 'vitest'
+import { cleanup, fireEvent, render, screen } from '@testing-library/react'
+import { makeTranslate } from '@deepseek-ai/dsh-client-test-runtime'
+import { zh as commonZh } from '@deepseek-ai/dsh-client-locale/src/locales/zh.ts'
+import type { ChatNodeViewProps } from '../src/client/contract/slots.ts'
+import { UserMessageNodeView, VEP_EVIDENCE_RE } from '../src/client/chat/MessageItem.tsx'
+import { zh } from '../src/client/locales.ts'
+
+// Mirrors the real lookup chain (conversation namespace, then common).
+const t: ChatNodeViewProps<'user' | 'steering'>['t'] = makeTranslate(zh, commonZh)
+
+function renderUser(content: readonly unknown[]) {
+  const viewNode = {
+    key: 'fixture:user:vep',
+    kind: 'user',
+    id: '1',
+    target: 'chat',
+    anchorSeq: 1,
+    location: { kind: 'session' },
+    visibility: 'visible',
+    data: { content, time: 0, source: null },
+  } as never
+  const props = { node: viewNode, renderMessageImages: () => null, t } as ChatNodeViewProps<'user' | 'steering'>
+  return render(<UserMessageNodeView {...props} />)
+}
+
+const VEP = 'VEP/1|src=deepseek-prism/zai-org/GLM-4.5V|m=ocr|a="Java 代码"|t="if(n){…}"'
+
+afterEach(() => { cleanup() })
+
+describe('VEP/1 evidence disclosure in user bubbles', () => {
+  it('recognizes the DeepSeek Prism fallback wrapper format', () => {
+    const match = VEP_EVIDENCE_RE.exec(`【DeepSeek Prism 识别：shot.png】\n${VEP}`)
+    expect(match).not.toBeNull()
+    expect(match?.[1]).toBe('shot.png')
+    expect(match?.[2]).toBe(VEP)
+    expect(VEP_EVIDENCE_RE.exec('普通文本')).toBeNull()
+    expect(VEP_EVIDENCE_RE.exec(`【DeepSeek Prism 识别：a.png】\n没有证据行`)).toBeNull()
+  })
+
+  it('folds the evidence into a link until expanded', () => {
+    renderUser([{ type: 'text', text: `【DeepSeek Prism 识别：shot.png】\n${VEP}` }])
+    const link = screen.getByRole('button', { name: '查看识别结果：shot.png' })
+    expect(link.getAttribute('aria-expanded')).toBe('false')
+    expect(screen.queryByText(VEP)).toBeNull()
+  })
+
+  it('expands the full evidence on click and collapses again', () => {
+    renderUser([{ type: 'text', text: `【DeepSeek Prism 识别：shot.png】\n${VEP}` }])
+    const link = screen.getByRole('button', { name: '查看识别结果：shot.png' })
+    fireEvent.click(link)
+    expect(screen.getByText(VEP)).toBeTruthy()
+    expect(screen.getByRole('button', { name: '查看识别结果：shot.png' }).getAttribute('aria-expanded')).toBe('true')
+    fireEvent.click(screen.getByRole('button', { name: '查看识别结果：shot.png' }))
+    expect(screen.queryByText(VEP)).toBeNull()
+  })
+
+  it('keeps ordinary text plain and preserves block order with multiple evidence blocks', () => {
+    renderUser([
+      { type: 'text', text: '先看看这张图' },
+      { type: 'text', text: `【DeepSeek Prism 识别：a.png】\n${VEP}` },
+      { type: 'text', text: `【DeepSeek Prism 识别：b.png】\n${VEP.replace('ocr', 'ui')}` },
+    ])
+    expect(screen.getByText('先看看这张图')).toBeTruthy()
+    expect(screen.getByRole('button', { name: '查看识别结果：a.png' })).toBeTruthy()
+    expect(screen.getByRole('button', { name: '查看识别结果：b.png' })).toBeTruthy()
+    fireEvent.click(screen.getByRole('button', { name: '查看识别结果：b.png' }))
+    expect(screen.getByText(VEP.replace('ocr', 'ui'))).toBeTruthy()
+    expect(screen.queryByText(VEP)).toBeNull()
+  })
+
+  it('decorates the link with token usage and shows balance/cost when expanded', () => {
+    renderUser([{
+      type: 'text',
+      text: `【DeepSeek Prism 识别：shot.png】\n${VEP}\n【DeepSeek Prism 用量】tokens=168|balance=12.34|cost=0.0012`,
+    }])
+    const link = screen.getByRole('button', { name: /查看识别结果：shot\.png/ })
+    expect(link.textContent).toContain('168 tokens')
+    expect(screen.queryByText(/余额/)).toBeNull()
+    fireEvent.click(link)
+    expect(screen.getByText(/余额 ¥12\.34/)).toBeTruthy()
+    expect(screen.getByText(/本次消耗约 ¥0\.0012/)).toBeTruthy()
+    expect(screen.getByText(VEP)).toBeTruthy()
+  })
+
+  it('formats large token counts and omits balance rows when absent', () => {
+    renderUser([{
+      type: 'text',
+      text: `【DeepSeek Prism 识别：a.png】\n${VEP}\n【DeepSeek Prism 用量】tokens=2048`,
+    }])
+    const link = screen.getByRole('button', { name: /查看识别结果：a\.png/ })
+    expect(link.textContent).toContain('2.0k tokens')
+    fireEvent.click(link)
+    expect(screen.queryByText(/余额/)).toBeNull()
+    expect(screen.queryByText(/消耗/)).toBeNull()
+  })
+
+  it('copies the joined text including the evidence', async () => {
+    const writeText = vi.fn().mockResolvedValue(undefined)
+    Object.defineProperty(navigator, 'clipboard', {
+      configurable: true,
+      value: { writeText },
+    })
+    renderUser([
+      { type: 'text', text: '看看这张图' },
+      { type: 'text', text: `【DeepSeek Prism 识别：shot.png】\n${VEP}` },
+    ])
+    const copy = screen.getAllByRole('button').find(button => button.getAttribute('aria-label') === '复制')
+    expect(copy).toBeTruthy()
+    fireEvent.click(copy!)
+    await vi.waitFor(() => {
+      expect(writeText).toHaveBeenCalledWith(`看看这张图【DeepSeek Prism 识别：shot.png】\n${VEP}`)
+    })
+  })
+})
